# --- Secrets -----------------------------------------------------------------
# Never commit API keys. OPENROUTER_API_KEY belongs in the environment or .env.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
ENV/
env/
.or/
.python-version

# --- Testing / coverage / type checking --------------------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# --- Notebooks ---------------------------------------------------------------
.ipynb_checkpoints/

# --- Editors / IDEs ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Generated media ---------------------------------------------------------
# Written by model_calls.py's call-image / call-video / call-speech into the
# working directory. These are API responses, not source - regenerate them
# instead of committing them. A custom output path needs its own entry here.
speech.mp3
generated_image*
generated_video*

# --- Logs / local scratch ----------------------------------------------------
*.log
logs/
tmp/
scratch/
*.csv
*.json
learning_log.txt

replay.go

# --- orlab (Go harness) ------------------------------------------------------
# Run artifacts hold full request/response bodies. Never commit a live run;
# the committed cassette under orlab/testdata is synthetic and regenerable.
orlab/runs/
orlab/reports/
*.jsonl

# The Python rules above ignore *.json and *.jsonl repo-wide. orlab's embedded
# suite, golden files, and fixtures are JSON source, so re-include them.
!orlab/internal/prompts/suite.json
!orlab/**/testdata/**

# --- Go build outputs --------------------------------------------------------
# Unstripped binaries embed local build paths. Rebuild with `go build` instead.
/pareto-lab/pareto-lab
/reasoning-explorer/reasoning-explorer
/tool-calling/tool-calling
/orlab/orlab
/jev-learning/jev_decisions
/jev-learning/jev-learning
# Anything else: build into bin/ (go build -o bin/) so it is ignored by default.
bin/
